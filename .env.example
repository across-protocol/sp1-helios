# The source chain is the chain that the light client will sync from.
# Comma-separated beacon API URLs. They must serve light-client endpoints for the current fork.
CONSENSUS_RPCS_LIST=
# Comma-separated execution JSON-RPC URLs. Must support eth_getProof at finalized blocks and
# return the current fork's block header fields.
SOURCE_EXECUTION_RPC_URL=
# 1 (mainnet) or 11155111 (Sepolia).
SOURCE_CHAIN_ID=

# Set to mock for testing, or network to generate proofs on the Succinct Prover Network.
# Unset defaults to local CPU proving, which is not practical for this program.
SP1_PROVER=mock

# Required when SP1_PROVER=network: private key of the prover-network requester account.
NETWORK_PRIVATE_KEY=
# Optional override for the prover-network RPC URL. Leave unset for the default.
NETWORK_RPC_URL=

# Required by `cargo run --bin genesis`. Always needed to derive the deployer/updater address.
PRIVATE_KEY=

# Required by `cargo run --bin genesis` when SP1_PROVER=network.
SP1_VERIFIER_ADDRESS=
VKEY_UPDATER=

# Optional override for contract updaters. Comma-separated addresses.
UPDATERS=

# Redis (required for zk-api)
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=sp1-helios
# TTL of the global Redis lock held while updating the finalized header and proof states.
REDIS_LOCK_DURATION_SECS=10

# zk-api HTTP port.
PORT=8080

# Beacon block root the zk-api bootstraps from on first start, when Redis holds no finalized
# header yet. Use the `header` value from the genesis.json that deployed the SP1Helios contract.
# Ignored once a finalized header exists in Redis.
INIT_CHECKPOINT=

# Logging. RUST_LOG uses tracing EnvFilter syntax (default: info).
RUST_LOG=info
# Optional Slack alerting: set a webhook URL to forward log events at or above SLACK_LOG_LEVEL
# (default: WARN).
SLACK_WEBHOOK_URL=
SLACK_LOG_LEVEL=WARN
